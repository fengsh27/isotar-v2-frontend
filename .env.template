# Secrets for the isoTar-v2 backend container started by docker-compose.yml.
#
#     cp .env.template .env
#     # fill in the values below
#     docker compose up -d
#
# Compose passes this file to the `backend` service (`env_file:`); the
# frontend never sees it. `.env` is git-ignored: never commit it, paste it
# into an issue, or echo it in a shell log. Lines starting with `#` and blank
# lines are ignored; values are taken literally (do not quote them).
#
# Both sections are optional. Leaving one blank only disables that feature:
# without NCBI_API_KEY the backend answers 503 on the verification endpoints
# and the job page hides the "Verify against literature" button; without
# ANTHROPIC_AUTH_TOKEN the model-review checkbox is disabled with a note.
# The full list of backend settings is in isoTar-v2/.env.template.

# ---------------------------------------------------------------------------
# NCBI E-utilities (PubMed search for the literature verification)
# ---------------------------------------------------------------------------
# Get a key at https://www.ncbi.nlm.nih.gov/account/settings/ ("API Key
# Management"). It lifts the E-utilities limit from 3 to 10 requests/second.
NCBI_API_KEY=
# Contact address sent with every E-utilities call, as NCBI's usage policy asks.
NCBI_EMAIL=

# ---------------------------------------------------------------------------
# Anthropic-compatible gateway (model review of candidate papers)
# ---------------------------------------------------------------------------
# Root of your LiteLLM gateway, without a trailing slash and without `/v1`:
# the Anthropic SDK inside the backend appends `/v1/messages` itself.
ANTHROPIC_BASE_URL=https://litellm.example.org
# Your LiteLLM virtual key (usually `sk-...`), sent as
# `Authorization: Bearer <token>`. Do not use ANTHROPIC_API_KEY here: that is
# sent as `x-api-key` and is meant for direct access to api.anthropic.com.
ANTHROPIC_AUTH_TOKEN=
# Model name exactly as the gateway exposes it (see the gateway's /v1/models).
ISOTAR_VERIFICATION_MODEL=claude-opus-5-5
